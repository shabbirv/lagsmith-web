Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# www -> apex
RewriteCond %{HTTP_HOST} ^www\.lagsmith\.com$ [NC]
RewriteRule ^ https://lagsmith.com%{REQUEST_URI} [R=301,L]

# The usual sitemap address -> the one Astro generates
RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

# /page.html -> /page, /page/ -> /page
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index[\s?]
RewriteRule ^ / [R=301,L]
RewriteRule ^(.+)/$ /$1 [R=301,L]

# AI tools that ask for Markdown get the page's Markdown copy (written by scripts/markdown.mjs).
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ index.md [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/$1.md -f
RewriteRule ^(.+)$ $1.md [L]

# /page -> page.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

AddType text/markdown .md
AddCharset utf-8 .html .md .txt

<IfModule mod_headers.c>
  Header set Link "</sitemap-index.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/site.json>; rel=\"describedby\"; type=\"application/ld+json\""
  <FilesMatch "\.(html|md)$">
    Header append Vary Accept
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg|webp|jpg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|md|txt|json|xml)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain text/markdown application/json application/ld+json
</IfModule>
