---
// An illustrative Claude Code session using Lagsmith's MCP server. Lines appear one by one
// when the terminal scrolls into view. The whole transcript is in the HTML for search engines
// and screen readers; the animation only reveals it.

type Block =
  | { t: 'prompt'; text: string }
  | { t: 'say'; text: string }
  | { t: 'call'; tool: string; args?: string }
  | { t: 'bash'; cmd: string }
  | { t: 'out'; text: string };

const blocks: Block[] = [
  { t: 'prompt', text: 'Run the checkout UI tests on 3G with the payments API returning 503s, and tell me what breaks.' },
  { t: 'say', text: 'I’ll find the app in the simulator first.' },
  { t: 'call', tool: 'list_targets' },
  { t: 'out', text: 'simulators: iPhone 17 Pro (booted)\napps: com.pantryhq.Pantry, com.apple.mobilesafari, …\npresets: Edge, 3G, DSL, LTE, WiFi, Very Bad Network, 100% Loss' },
  { t: 'call', tool: 'set_network', args: 'app: "com.pantryhq.Pantry", simulator: "booted", preset: "3G"' },
  { t: 'out', text: '{"ok": true, "rule": "Pantry", "preset": "3G",\n "conditions": {"down": 780, "up": 330, "latency": 200}}' },
  { t: 'call', tool: 'fail_endpoint', args: 'app: "com.pantryhq.Pantry", simulator: "booted",\n  pattern: "api.pantryhq.app/v1/payments", kind: "status", value: 503' },
  { t: 'out', text: '{"ok": true, "endpoints": [{"pattern": "api.pantryhq.app/v1/payments",\n  "kind": "status", "value": 503}]}' },
  { t: 'call', tool: 'relaunch_app', args: 'app: "com.pantryhq.Pantry", simulator: "booted"' },
  { t: 'out', text: '{"ok": true, "relaunched": ["Pantry on iPhone 17 Pro"]}' },
  { t: 'bash', cmd: 'xcodebuild test -scheme PantryUITests -only-testing:PantryUITests/CheckoutTests\n  -destination \'platform=iOS Simulator,name=iPhone 17 Pro\'' },
  { t: 'out', text: 'Test Suite \'CheckoutTests\' started\n✓ testCartLoads (4.8 s)\n✓ testApplyCoupon (6.1 s)\n✗ testPlaceOrder (30.0 s): Failed to find "Order confirmed" within 30 s\nExecuted 3 tests, with 1 failure' },
  { t: 'call', tool: 'get_requests', args: 'app: "com.pantryhq.Pantry", simulator: "booted",\n  filter: "host:api.pantryhq.app is:failed", include_bodies: true' },
  { t: 'out', text: 'POST https://api.pantryhq.app/v1/payments  503  injected by Lagsmith  2 ms\nPOST https://api.pantryhq.app/v1/payments  503  injected by Lagsmith  1 ms\nPOST https://api.pantryhq.app/v1/payments  503  injected by Lagsmith  1 ms\n(3 requests, 0.4 s apart)' },
  { t: 'call', tool: 'reset_network', args: 'app: "com.pantryhq.Pantry", simulator: "booted"' },
  { t: 'out', text: '{"ok": true, "preset": "No Throttling"}' },
  { t: 'say', text: 'Found it. On 3G the cart and coupon flows are fine, but when payments returns 503:\n\n1. PaymentService retries 3 times with no backoff (0.4 s apart), then gives up silently.\n2. The checkout screen keeps its spinner forever: there’s no error state for a failed\n   payment, so testPlaceOrder times out waiting for "Order confirmed".\n\nWant me to add exponential backoff and an error state with a "Try again" button in\nCheckoutView, then rerun the tests under the same conditions?' },
];

const argText = (args?: string) => (args ? `(${args})` : '');

// Colour test results and injected failures in output lines.
const outLine = (line: string) => {
  if (line.startsWith('✓')) return { cls: 'ok', line };
  if (line.startsWith('✗')) return { cls: 'bad', line };
  if (line.includes('injected by Lagsmith')) return { cls: 'warn', line };
  return { cls: '', line };
};
---
<figure class="term-figure">
  <div class="term" data-agent-terminal>
    <div class="term-bar" aria-hidden="true">
      <span class="term-lights"><i></i><i></i><i></i></span>
      <span class="term-title">~/Projects/Pantry — claude</span>
      <button class="term-replay" type="button" data-replay hidden>↻ Replay</button>
    </div>
    <div class="term-body" data-body>
      {blocks.map((b) => (
        <div class={`tb tb-${b.t}`} data-kind={b.t}>
          {b.t === 'prompt' && <div class="tb-prompt-box"><span class="caret">&gt;</span> <span data-type={b.text}>{b.text}</span></div>}
          {b.t === 'say' && <div class="tb-row"><span class="dot dot-say" aria-hidden="true"></span><span class="tb-text">{b.text}</span></div>}
          {b.t === 'call' && (
            <div class="tb-row"><span class="dot dot-tool" aria-hidden="true"></span><span class="tb-text"><b>lagsmith - {b.tool}</b> <span class="dim">(MCP)</span><span class="args">{argText(b.args)}</span></span></div>
          )}
          {b.t === 'bash' && <div class="tb-row"><span class="dot dot-tool" aria-hidden="true"></span><span class="tb-text"><b>Bash</b><span class="args">{argText(b.cmd)}</span></span></div>}
          {b.t === 'out' && (
            <div class="tb-row tb-out"><span class="elbow" aria-hidden="true"></span><span class="tb-text">{b.text.split('\n').map(outLine).map((l) => <span class={`ol ${l.cls}`}>{l.line}</span>)}</span></div>
          )}
        </div>
      ))}
    </div>
  </div>
  <figcaption>Illustrative Claude Code session using Lagsmith’s MCP server. Your agent stays at full speed; only Pantry is on 3G.</figcaption>
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  document.querySelectorAll<HTMLElement>('[data-agent-terminal]').forEach((term) => {
    const body = term.querySelector<HTMLElement>('[data-body]')!;
    const blocks = Array.from(body.querySelectorAll<HTMLElement>('.tb'));
    const replay = term.querySelector<HTMLButtonElement>('[data-replay]')!;
    const typed = body.querySelector<HTMLElement>('[data-type]');
    let run = 0;

    const pause: Record<string, number> = { prompt: 500, say: 700, call: 900, bash: 900, out: 1100 };

    const reveal = (el: HTMLElement) => {
      el.classList.add('shown');
      const bottom = el.offsetTop + el.offsetHeight + 16;
      if (bottom > body.scrollTop + body.clientHeight) {
        body.scrollTo({ top: bottom - body.clientHeight, behavior: reduce ? 'auto' : 'smooth' });
      }
    };

    async function play() {
      const id = ++run;
      replay.hidden = true;
      term.classList.add('animating');
      blocks.forEach((b) => b.classList.remove('shown'));
      body.scrollTop = 0;
      for (const el of blocks) {
        if (id !== run) return;
        if (el.dataset.kind === 'prompt' && typed) {
          const text = typed.dataset.type ?? '';
          typed.textContent = '';
          reveal(el);
          for (let i = 1; i <= text.length; i++) {
            if (id !== run) return;
            typed.textContent = text.slice(0, i);
            await sleep(18);
          }
          await sleep(pause.prompt);
          continue;
        }
        if (el.dataset.kind === 'out') el.classList.add('pending');
        reveal(el);
        await sleep(el.dataset.kind === 'out' ? 450 : 0);
        el.classList.remove('pending');
        await sleep(pause[el.dataset.kind ?? 'say'] ?? 700);
      }
      term.classList.remove('animating');
      replay.hidden = false;
    }

    if (reduce) {
      blocks.forEach((b) => b.classList.add('shown'));
      return;
    }

    term.classList.add('js');
    replay.addEventListener('click', play);
    new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) {
        obs.disconnect();
        play();
      }
    }, { threshold: 0.35 }).observe(term);
  });
</script>

<style>
  .term-figure { margin: 0; }
  .term { background: #141414; color: #e6e6e6; border-radius: 14px; overflow: hidden; box-shadow: 0 0 0 1px rgba(255,255,255,0.08), 0 30px 80px -24px rgba(15,26,43,0.55); text-align: left; }
  .term-bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: #232323; border-bottom: 1px solid #000; font-size: 12px; color: #a3a3a3; }
  .term-lights { display: flex; gap: 7px; }
  .term-lights i { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .term-lights i:nth-child(2) { background: #febc2e; }
  .term-lights i:nth-child(3) { background: #28c840; }
  .term-title { flex: 1; text-align: center; font-family: var(--font); }
  .term-replay { font: inherit; color: #d4d4d4; background: rgba(255,255,255,0.08); border: 0; border-radius: 6px; padding: 3px 10px; cursor: pointer; }
  .term-replay:hover { background: rgba(255,255,255,0.14); }
  .term-body { position: relative; height: 520px; overflow-y: auto; padding: 18px 20px 24px; font-family: var(--mono); font-size: 12.5px; line-height: 1.55; scrollbar-width: thin; scrollbar-color: #3a3a3a transparent; }
  .tb { margin-bottom: 12px; }
  .term.js .tb { visibility: hidden; }
  .term.js .tb.shown { visibility: visible; animation: tb-in 0.25s ease-out; }
  @keyframes tb-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .tb-prompt-box { border: 1px solid #4a4a4a; border-radius: 8px; padding: 8px 12px; white-space: pre-wrap; }
  .caret { color: #a3a3a3; }
  .tb-row { display: grid; grid-template-columns: 20px 1fr; }
  .tb-text { white-space: pre-wrap; overflow-wrap: anywhere; }
  .dot { width: 8px; height: 8px; border-radius: 50%; margin-top: 0.45em; }
  .dot-say { background: #e6e6e6; }
  .dot-tool { background: #4ade80; }
  .args { color: #bdbdbd; }
  .dim { color: #8a8a8a; }
  .tb-out { padding-left: 20px; grid-template-columns: 24px 1fr; color: #a3a3a3; margin-top: -8px; }
  .elbow { width: 9px; height: 0.75em; margin-left: 2px; border-left: 1.5px solid #6b6b6b; border-bottom: 1.5px solid #6b6b6b; }
  .ol { display: block; min-height: 1.55em; }
  .ol.ok { color: #4ade80; }
  .ol.bad { color: #f87171; }
  .ol.warn { color: #fbbf24; }
  .tb.pending .tb-text { opacity: 0.35; }
  .term-figure figcaption { font-size: 0.85rem; color: var(--muted); margin-top: 12px; text-align: center; }
  @media (max-width: 640px) {
    .term-body { height: 460px; font-size: 11.5px; padding: 14px; }
    .term-title { display: none; }
  }
</style>
