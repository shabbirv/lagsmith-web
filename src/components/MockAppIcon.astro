---
// App icons for the fictional apps in the window illustration.
export type MockIcon = 'waypoint' | 'inkwell' | 'harbor' | 'pantry' | 'pulse' | 'tempo';
interface Props { icon: MockIcon; size?: number }
const { icon, size = 24 } = Astro.props;

const icons: Record<MockIcon, { from: string; to: string }> = {
  waypoint: { from: '#38bdf8', to: '#0d9488' },
  inkwell: { from: '#fbbf24', to: '#ea580c' },
  harbor: { from: '#818cf8', to: '#4338ca' },
  pantry: { from: '#4ade80', to: '#15803d' },
  pulse: { from: '#fb7185', to: '#be123c' },
  tempo: { from: '#c084fc', to: '#7e22ce' },
};
const { from, to } = icons[icon];
const id = `g-${icon}-${size}`;
---
<svg class="mock-icon" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={from} />
      <stop offset="1" stop-color={to} />
    </linearGradient>
  </defs>
  <rect width="40" height="40" rx="9" fill={`url(#${id})`} />
  <g fill="#fff" stroke="none">
    {icon === 'waypoint' && (
      <>
        <path d="M20 8a8.5 8.5 0 0 0-8.5 8.5C11.5 23 20 32 20 32s8.5-9 8.5-15.5A8.5 8.5 0 0 0 20 8z" />
        <circle cx="20" cy="16.5" r="3.3" fill={to} />
      </>
    )}
    {icon === 'inkwell' && <path d="M11 29l1.8-6.2L25 10.6a2.4 2.4 0 0 1 3.4 0l1 1a2.4 2.4 0 0 1 0 3.4L17.2 27.2z" />}
    {icon === 'harbor' && (
      <>
        <rect x="9" y="12" width="22" height="16" rx="3" />
        <path d="M10 14l10 7 10-7" fill="none" stroke={to} stroke-width="2" stroke-linejoin="round" />
      </>
    )}
    {icon === 'pantry' && (
      <>
        <path d="M11 29c0-10.5 6.5-17 18-17 0 11.5-6.5 18-18 17z" />
        <path d="M12 28l10-10" fill="none" stroke={to} stroke-width="2" stroke-linecap="round" />
      </>
    )}
    {icon === 'tempo' && (
      <>
        <path d="M17 11.5l11-2.5v15" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round" />
        <path d="M17 11.5V27" fill="none" stroke="#fff" stroke-width="2.4" />
        <ellipse cx="14" cy="27.5" rx="4" ry="3.2" />
        <ellipse cx="25" cy="24.5" rx="4" ry="3.2" />
      </>
    )}
    {icon === 'pulse' && <path d="M20 30s-10-6-10-13a5.5 5.5 0 0 1 10-3.2A5.5 5.5 0 0 1 30 17c0 7-10 13-10 13z" />}
  </g>
</svg>
