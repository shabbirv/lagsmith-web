---
// The app's "Buy Lagsmith Pro" button opens this URL; it must always exist.
// Stripe (SITE.checkout = 'stripe'): asks the licence service for a Checkout Session and sends the
// buyer to Stripe's page; the service applies the launch coupon while it's valid. Stripe returns
// them to /thanks?session=….
// Paddle: opens Paddle's overlay checkout with the launch discount; after payment the buyer goes
// to /thanks?txn=…. Either way the thank-you page fetches the licence key from the licence service.
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { SITE, currentPrice, reseller } from '../config';

const launch = currentPrice();
const provider = SITE.checkout;
const stripe = { enabled: SITE.stripe.enabled };
const checkout = {
  enabled: SITE.paddle.enabled,
  environment: SITE.paddle.environment,
  token: SITE.paddle.clientToken,
  priceId: SITE.paddle.priceId,
  discountId: launch.regularLabel ? SITE.paddle.launchDiscountId : null,
};
---
<Base title="Buy Lagsmith Pro" description="Buy Lagsmith Pro." noindex>
  <section class="page-head center">
    <div class="wrap narrow">
      <h1>Buy Lagsmith Pro</h1>
      <p class="lead">
        {launch.regularLabel
          ? <><s class="muted">{launch.regularLabel}</s> <strong>{launch.label}</strong> launch price until {launch.launchEndsLabel}. One-time purchase with a year of updates.</>
          : <><strong>{launch.label}</strong>, one-time purchase with a year of updates.</>}
      </p>

      <div id="checkout-ready" hidden>
        <div class="actions"><button class="btn btn-primary" id="open-checkout" type="button">Continue to checkout</button></div>
        <p id="checkout-error" class="muted" role="alert" hidden>We couldn’t open checkout. Please try again, or email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</p>
        <p class="muted" style="font-size: 0.9rem">Payments are handled by {reseller().name}, our reseller. Tax is calculated at checkout. <a href="/refunds">{SITE.legal.refundDays}-day refunds</a>, no questions asked.</p>
      </div>

      <div id="checkout-off">
        <p>Lagsmith Pro purchases open soon. In the meantime, every install includes a 14-day Pro trial.</p>
        <div class="actions"><DownloadButton /></div>
        <p class="muted">Questions? <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></p>
      </div>
    </div>
  </section>

  {provider === 'stripe' && (
    <script is:inline define:vars={{ stripe }}>
      (() => {
        const params = new URLSearchParams(location.search);
        if (!(stripe.enabled || params.has('test'))) return;
        document.getElementById('checkout-off').hidden = true;
        document.getElementById('checkout-ready').hidden = false;
        const button = document.getElementById('open-checkout');
        const error = document.getElementById('checkout-error');

        const open = async () => {
          button.disabled = true;
          button.textContent = 'Opening checkout…';
          error.hidden = true;
          try {
            const res = await fetch('/api/checkout', { method: 'POST' });
            const { url } = await res.json();
            if (!res.ok || !url) throw new Error('no checkout url');
            // Give the analytics request up to a second, then leave without adding /buy to history,
            // so Back from Stripe's page doesn't bounce straight back into checkout.
            const sent = window.umami?.track('Checkout opened');
            await Promise.race([sent, new Promise((r) => setTimeout(r, 1000))]);
            location.replace(url);
          } catch {
            button.disabled = false;
            button.textContent = 'Continue to checkout';
            error.hidden = false;
          }
        };
        button.addEventListener('click', open);
        open();
      })();
    </script>
  )}
  {provider === 'paddle' && (
    <Fragment>
    <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js" defer></script>
    <script is:inline define:vars={{ checkout }}>
    window.addEventListener('load', () => {
      const params = new URLSearchParams(location.search);
      // ?_ptxn=… is a payment link from Paddle (emails, dashboard); Paddle.js opens that checkout itself.
      const paymentLink = params.has('_ptxn');
      const testing = params.has('sandbox');
      if (!(checkout.enabled || testing || paymentLink) || !window.Paddle) return;

      document.getElementById('checkout-off').hidden = true;
      document.getElementById('checkout-ready').hidden = false;

      if (checkout.environment === 'sandbox') Paddle.Environment.set('sandbox');
      let completed = false;
      Paddle.Initialize({
        token: checkout.token,
        eventCallback: (event) => {
          const track = (name, data) => window.umami?.track(name, data);
          if (event.name === 'checkout.loaded') track('Checkout opened');
          if (event.name === 'checkout.payment.initiated') track('Payment started');
          if (event.name === 'checkout.closed' && !completed) track('Checkout closed');
          if (event.name === 'checkout.completed') {
            completed = true;
            const sent = track('Purchase', { revenue: event.data?.totals?.total, currency: event.data?.currency_code, country: event.data?.customer?.address?.country_code });
            const txn = event.data?.transaction_id;
            // Give the analytics request up to a second before leaving the page.
            if (txn) Promise.race([sent, new Promise((r) => setTimeout(r, 1000))]).finally(() => {
              location.href = `/thanks?txn=${encodeURIComponent(txn)}`;
            });
          }
        },
      });

      const open = () =>
        Paddle.Checkout.open({
          ...(paymentLink
            ? { transactionId: params.get('_ptxn') }
            : { items: [{ priceId: checkout.priceId, quantity: 1 }], ...(checkout.discountId ? { discountId: checkout.discountId } : {}) }),
          settings: {
            displayMode: 'overlay',
            theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
            locale: 'en',
          },
        });

      document.getElementById('open-checkout').addEventListener('click', open);
      if (!paymentLink) open();
    });
  </script>
    </Fragment>
  )}
</Base>
