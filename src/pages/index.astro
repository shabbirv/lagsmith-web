---
import Base from '../layouts/Base.astro';
import NlcTable from '../components/NlcTable.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import AppMock from '../components/AppMock.astro';
import AgentTerminal from '../components/AgentTerminal.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { SITE, currentPrice } from '../config';
import PriceTag from '../components/PriceTag.astro';

const launch = currentPrice();
import { appSchema, faqSchema, siteSchemas } from '../lib';

const faq = [
  { q: 'How is Lagsmith different from Apple’s Network Link Conditioner?', a: 'Network Link Conditioner slows down the whole Mac. Lagsmith slows down only the apps you pick, including individual apps in the iOS Simulator, and adds failure modes, request monitoring and automation. <a href="/network-link-conditioner-alternative">See the full comparison</a>.' },
  { q: 'Does it work with the iOS Simulator?', a: 'Yes. Pick an app in a booted simulator and Lagsmith slows down or breaks only that app, even on one simulator device while another runs normally.' },
  { q: 'Do I need to install a certificate or change proxy settings?', a: 'No. Lagsmith sees the requests of simulator apps without certificates or proxy settings, and everything stays on your Mac.' },
  { q: 'What does Lagsmith install?', a: 'A network extension. macOS asks you to allow it once in System Settings. <a href="/docs/getting-started">See getting started</a>.' },
  { q: 'Which Macs does it run on?', a: `${SITE.minMacOS}, on Apple silicon and Intel.` },
  { q: 'Is there a free version?', a: 'Yes. Every install starts with a 14-day Pro trial with no account or card. After that, the free version keeps working: watch any app, see its last 50 requests and its connections, and slow it down with the Edge preset.' },
  { q: 'Does Lagsmith collect any data?', a: 'No. Everything runs locally, there is no account, and the app has no analytics.' },
];

// Short on purpose: each card links to the page with the detail.
const features = [
  { icon: 'gauge', title: 'Throttle one app', text: '3G, Edge, LTE or your own bandwidth, latency and packet loss. Everything else stays fast.', href: '/throttle-ios-simulator' },
  { icon: 'plane', title: 'Break it on purpose', text: 'Airplane Mode, time-outs and dropped connections for one app.', href: '/simulate-airplane-mode-ios-simulator' },
  { icon: 'target', title: 'Fail or mock one endpoint', text: 'Take one API offline or fake its response. The rest keeps working.', href: '/mock-api-ios-simulator' },
  { icon: 'list', title: 'See every request', text: 'URLs, headers, bodies and timing for simulator apps. Export as HAR.', href: '/docs/monitoring' },
  { icon: 'play', title: 'Automate it', text: 'Set the network from UI tests, the command line or a URL.', href: '/docs/automation' },
  { icon: 'spark', title: 'Let your AI agent drive', text: 'A built-in MCP server for Claude Code, Cursor, Codex and more.', href: '/ai-agents-network-testing' },
];
const icons: Record<string, string> = {
  gauge: '<path d="M4 15a8 8 0 1 1 16 0"/><path d="M12 15l4-5"/>',
  plane: '<path d="M10.5 3.5 12 3l1.5.5v6l7 4v2l-7-2v4l2 1.5V20l-3.5-1L8.5 20v-1l2-1.5v-4l-7 2v-2l7-4z"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/>',
  list: '<path d="M8 6h12M8 12h12M8 18h12"/><circle cx="4" cy="6" r=".6"/><circle cx="4" cy="12" r=".6"/><circle cx="4" cy="18" r=".6"/>',
  play: '<path d="M7 4.5v15l12-7.5z"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>',
};
---
<Base
  title="Lagsmith: slow down one app, not your whole Mac"
  description="Lagsmith throttles and breaks the network for one app at a time on your Mac, including iOS Simulator apps. A per-app alternative to Network Link Conditioner."
  jsonLd={[...siteSchemas(), appSchema(), faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Network testing for iOS and macOS developers</p>
        <h1>Slow down one app, not your whole Mac</h1>
        <p class="lead">Throttle or break the network for one app, including apps in the iOS Simulator. Everything else, including your AI agent, stays at full speed.</p>
        <div class="actions">
          <DownloadButton />
          <a class="btn btn-secondary" href="/network-link-conditioner-alternative">Why not Network Link Conditioner?</a>
        </div>
        <p class="hero-note">
          Free, with a 14-day Pro trial. No account. {SITE.minMacOS}.
          {launch.regularLabel && <><br /><a href="/pricing">Pro is <s>{launch.regularLabel}</s> <strong>{launch.label}</strong> until {launch.launchEndsLabel}</a></>}
        </p>
      </div>
      <div class="mock-wide"><AppMock /></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">For AI coding agents</p>
        <h2 style="margin-top: 0">Run your end-to-end tests on 3G without slowing down your agent</h2>
        <p>Throttle the whole Mac and your agent slows down too. With Lagsmith’s MCP server, it slows down only the app under test, runs your tests and reads the failed requests.</p>
        <p><a href="/docs/mcp">Set up the MCP server</a></p>
      </div>
      <AgentTerminal variant="short" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">Everything you need to test bad networks</h2>
      <div class="grid">
        {features.map((f) => (
          <a class="card feature" href={f.href}>
            <svg class="feature-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[f.icon]} />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="wrap">
      <p class="eyebrow">Compared with Apple’s Network Link Conditioner</p>
      <h2 style="margin-top: 0">Network Link Conditioner, per app</h2>
      <NlcTable short />
      <p><a href="/network-link-conditioner-alternative">Read the full comparison</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">Free to start, Pro when you need it</h2>
      <div class="plans">
        <div class="plan">
          <h3>Free</h3>
          <ul>
            <li>Watch any app</li>
            <li>See its last 50 requests and its connections</li>
            <li>Slow it down with the Edge preset</li>
          </ul>
        </div>
        <div class="plan pro">
          <h3>Pro</h3>
          <PriceTag />
          <ul>
            <li>Every preset per app, custom presets and profiles</li>
            <li>Airplane Mode and failure modes</li>
            <li>Fail and mock endpoints</li>
            <li>UI tests, command line and MCP for AI agents</li>
            <li>Unlimited history, search filters, HAR export, mini monitor</li>
          </ul>
        </div>
      </div>
      <p><a href="/pricing">See pricing</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <Faq items={faq} />
    </div>
  </section>

  <Cta />
</Base>

<style>
  .hero-note { font-size: 0.9rem; color: var(--muted); line-height: 1.7; }
  .hero-note a { color: inherit; text-decoration: none; }
  .hero-note a:hover { color: var(--text); }
  .hero-note strong { color: var(--text); }
  .feature { display: block; color: inherit; text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
  .feature:hover { border-color: var(--accent); transform: translateY(-2px); }
  .feature h3 { margin: 12px 0 6px; }
  .feature p { color: var(--muted); margin: 0; }
  .feature-icon { width: 36px; height: 36px; padding: 7px; border-radius: 10px; background: var(--accent-bg); stroke: var(--accent); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
</style>
