---
import Base from '../layouts/Base.astro';
import NlcTable from '../components/NlcTable.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import AppMock from '../components/AppMock.astro';
import AgentTerminal from '../components/AgentTerminal.astro';
import MiniMonitor from '../components/MiniMonitor.astro';
import InspectorMock from '../components/InspectorMock.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { SITE } from '../config';
import PriceTag from '../components/PriceTag.astro';

import { appSchema, faqSchema, siteSchemas } from '../lib';

const faq = [
  { q: 'How is Lagsmith different from Apple’s Network Link Conditioner?', a: 'Network Link Conditioner slows down the whole Mac. Lagsmith slows down only the apps you pick, including individual apps in the iOS Simulator, and adds failure modes, request monitoring and automation. <a href="/network-link-conditioner-alternative">See the full comparison</a>.' },
  { q: 'Does it work with the iOS Simulator?', a: 'Yes. Pick an app in a booted simulator and Lagsmith slows down or breaks only that app, even on one simulator device while another runs normally.' },
  { q: 'Do I need to install a certificate or change proxy settings?', a: 'No. Lagsmith sees the requests of simulator apps without certificates or proxy settings, and everything stays on your Mac.' },
  { q: 'What does Lagsmith install?', a: 'A network extension. macOS asks you to allow it once in System Settings. <a href="/docs/getting-started">See getting started</a>.' },
  { q: 'Which Macs does it run on?', a: `${SITE.minMacOS}, on Apple silicon and Intel.` },
  { q: 'Is there a free version?', a: 'Yes. Every install starts with a 14-day Pro trial with no account or card. After that, the free version keeps working: watch any app, see its last 50 requests and its connections, and slow it down with the Edge preset.' },
  { q: 'Does Lagsmith collect any data?', a: 'No. Everything runs locally, there is no account, and the app has no analytics.' },
];

// The rest of what it does, one line each, linking to the detail.
const features = [
  { title: 'Throttle one app', text: '3G, Edge, LTE, or your own bandwidth, latency and packet loss.', href: '/throttle-ios-simulator' },
  { title: 'Airplane Mode for one app', text: 'Plus time-outs, refused and dropped connections.', href: '/simulate-airplane-mode-ios-simulator' },
  { title: 'Fail or mock one endpoint', text: 'Make /v1/payments return a 503 and leave the rest of the API alone.', href: '/mock-api-ios-simulator' },
  { title: 'Automation', text: 'Set the network from XCUITest, the command line or a lagsmith:// link.', href: '/docs/automation' },
  { title: 'MCP server', text: 'For Claude Code, Cursor, Codex and anything else that speaks MCP.', href: '/ai-agents-network-testing' },
  { title: 'HAR export', text: 'Hand a recording of the bad session to whoever owns the backend.', href: '/docs/monitoring' },
];
---
<Base
  title="Lagsmith: slow down one app, not your whole Mac"
  description="Lagsmith throttles and breaks the network for one app at a time on your Mac, including iOS Simulator apps. A per-app alternative to Network Link Conditioner."
  jsonLd={[...siteSchemas(), appSchema(), faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">Network testing for iOS and macOS developers</p>
        <h1>Network Link Conditioner for a single app</h1>
        <p class="lead">Network Link Conditioner slows down your whole Mac: Xcode, Slack, and the agent writing your code. Lagsmith puts only the app you pick on 3G, even one app on one simulator.</p>
        <div class="actions">
          <DownloadButton />
          <a class="btn btn-secondary" href="/network-link-conditioner-alternative">How it compares</a>
        </div>
        <p class="hero-note"><strong>Free download.</strong> 14-day Pro trial, no account. {SITE.minMacOS}.</p>
      </div>
      <div class="mock-wide"><AppMock /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2 style="margin-top: 0">Your agent can test on 3G without crawling along with the app</h2>
        <p>Lagsmith has an MCP server. Ask Claude Code to test checkout on a bad network and it puts just your app on 3G, runs the UI tests, and reads the requests that failed.</p>
        <p><a href="/docs/mcp">Set up the MCP server</a></p>
      </div>
      <AgentTerminal variant="short" />
    </div>
  </section>

  <section class="section">
    <div class="wrap split split-reverse">
      <MiniMonitor />
      <div>
        <h2 style="margin-top: 0">A small window next to the simulator</h2>
        <p>The mini monitor floats beside the app you’re testing and lists its requests as they happen, so you can see the time-out while you tap around. Click it to open the inspector.</p>
        <p><a href="/docs/monitoring">Request monitoring</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">See every request, down to the photo</h2>
      <p class="lead">Headers, bodies and timing for every request a simulator app makes, with no certificate to install. JSON opens as a tree, and hovering an image URL shows the image.</p>
      <InspectorMock />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">What else it does</h2>
      <dl class="features">
        {features.map((f) => (
          <div>
            <dt><a href={f.href}>{f.title}</a></dt>
            <dd>{f.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">Compared with Network Link Conditioner</h2>
      <NlcTable short />
      <p><a href="/network-link-conditioner-alternative">Read the full comparison</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top: 0">Pricing</h2>
      <div class="plans">
        <div class="plan">
          <h3>Free</h3>
          <ul>
            <li>Watch any app</li>
            <li>See its last 50 requests and its connections</li>
            <li>Slow it down with the Edge preset</li>
          </ul>
        </div>
        <div class="plan pro">
          <h3>Pro</h3>
          <PriceTag />
          <ul>
            <li>Every preset per app, custom presets and profiles</li>
            <li>Airplane Mode and failure modes</li>
            <li>Fail and mock endpoints</li>
            <li>UI tests, command line and MCP for AI agents</li>
            <li>Unlimited history, search filters, HAR export, mini monitor</li>
          </ul>
        </div>
      </div>
      <p><a href="/pricing">See pricing</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <Faq items={faq} title="Questions" />
    </div>
  </section>

  <Cta />
</Base>

<style>
  .hero-note { font-size: 0.9rem; color: var(--muted); }
  .hero-note strong { color: var(--text); }
  .features { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 48px; margin: 0; }
  .features dt { font-weight: 600; }
  .features dt a { color: var(--text); }
  .features dd { margin: 2px 0 0; color: var(--muted); }
  @media (max-width: 640px) { .features { grid-template-columns: 1fr; } }
</style>
